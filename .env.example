PORT=3000

# Feishu app credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Supported values: long_connection, webhook
FEISHU_DELIVERY_MODE=long_connection

# Supported values: prefix, mention_or_prefix, all
FEISHU_TRIGGER_MODE=mention_or_prefix

# Supported values: card, text
FEISHU_REPLY_FORMAT=card

# Optional: limit which chats can trigger Codex, comma-separated
FEISHU_ALLOWED_CHAT_IDS=

# Optional command prefix. Still works in mention_or_prefix mode.
COMMAND_PREFIX=/codex

# How to invoke your local Codex service
# Supported values: http, openai_compatible, cli, codex_exec, mock
CODEX_MODE=codex_exec

# HTTP mode
CODEX_HTTP_URL=http://127.0.0.1:4000/run
CODEX_HTTP_METHOD=POST
CODEX_HTTP_TIMEOUT_MS=600000
CODEX_HTTP_AUTH_HEADER=
CODEX_HTTP_AUTH_TOKEN=

# OpenAI-compatible API mode
# Supported presets: custom, xingwan, qhaigc
OPENAI_COMPAT_PROVIDER=custom
OPENAI_COMPAT_API_KEY=
XINGWAN_API_KEY=
QHAIGC_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_CHAT_COMPLETIONS_URL=
OPENAI_COMPAT_MODEL=gpt-4o-mini
OPENAI_COMPAT_SYSTEM_PROMPT=You are a concise assistant replying to Feishu messages.
OPENAI_COMPAT_TEMPERATURE=0.2
OPENAI_COMPAT_MAX_TOKENS=2000
OPENAI_COMPAT_TIMEOUT_MS=120000

# Image generation mode
# Supported presets: custom, xingwan
IMAGE_GENERATION_PROVIDER=xingwan
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://xingwan.store/v1
IMAGE_GENERATION_URL=
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_QUALITY=

# Local Feishu voice and /note text notes -> Obsidian
# Safe default: disabled until a private chat allowlist is configured.
VOICE_NOTES_ENABLED=false
OBSIDIAN_VAULT_PATH=/absolute/path/to/Obsidian Vault
VOICE_NOTE_RELATIVE_DIR=00_Inbox/feishu/每日口述
VOICE_NOTE_ALLOWED_CHAT_IDS=oc_xxx
VOICE_NOTE_TIME_ZONE=Asia/Shanghai
VOICE_NOTE_MAX_AUDIO_BYTES=26214400
VOICE_NOTE_MAX_DURATION_MS=1800000
VOICE_NOTE_QUEUE_DIR=.data/voice-note-jobs
VOICE_NOTE_DOWNLOAD_TIMEOUT_MS=60000
VOICE_NOTE_TRANSCRIBE_TIMEOUT_MS=1800000
VOICE_NOTE_LANGUAGE=zh
VOICE_NOTE_INITIAL_PROMPT=这是一段飞书口述笔记，内容涉及 Obsidian、Codex、每周复盘和生活笔记。
FFMPEG_COMMAND=/opt/homebrew/bin/ffmpeg
WHISPER_COMMAND=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL_PATH=/absolute/path/to/ggml-large-v3-turbo-q5_0.bin

# CLI mode
CODEX_CLI_COMMAND=codex
CODEX_CLI_ARGS=
CODEX_CLI_TIMEOUT_MS=600000

# Native Codex exec mode
CODEX_EXEC_COMMAND=codex
# Optional: defaults to the current git repo root when omitted
CODEX_EXEC_WORKDIR=/Users/kevin/CodeWorkSpace/garrytan-gstack
CODEX_EXEC_ARGS=exec,--skip-git-repo-check
CODEX_EXEC_TIMEOUT_MS=600000

# Set to true to skip Feishu outbound API and log replies locally
MOCK_FEISHU_SEND=false
