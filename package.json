{
  "name": "feishu-codex-bridge",
  "version": "0.2.0-beta.1",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "desktop:dev": "vite --config desktop/vite.config.ts",
    "desktop:build": "tsc -p desktop/tsconfig.json --noEmit && vite build --config desktop/vite.config.ts",
    "desktop:test": "vitest run --config desktop/vitest.config.ts",
    "tauri:dev": "npm run sidecar:build && npm run native:prepare-dev && tauri dev --config desktop/src-tauri/tauri.conf.json",
    "tauri:build": "npm run sidecar:build && npm run native:build && tauri build --config desktop/src-tauri/tauri.conf.json",
    "tauri:ci": "tauri build --config desktop/src-tauri/tauri.conf.json",
    "sidecar:bundle": "node scripts/bundle-sidecar.mjs",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "native:prepare-dev": "node scripts/prepare-native-dev.mjs",
    "native:build": "bash scripts/build-native-sidecars.sh",
    "licenses:generate": "node scripts/generate-third-party-manifest.mjs",
    "lint": "eslint desktop/src scripts --max-warnings=0",
    "test:node": "node --test test/*.test.mjs",
    "test": "npm run test:node && npm run desktop:test",
    "check": "node --check src/server.mjs && npm run lint && npm run test && npm run desktop:build"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
